# Required: use the same real MongoDB as the Node backend. There is no
# localhost fallback in the Python service. The service also reads this
# value from backend/.env, but a service-local .env wins.
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/metabolic_city?retryWrites=true&w=majority
MONGODB_DB_NAME=metabolic_city

INTELLIGENCE_ENV=development
INTELLIGENCE_HOST=127.0.0.1
INTELLIGENCE_PORT=8001
ESCALATION_TIMEOUT_MINUTES=15

# Realtime derived-state sync. Change streams need a replica set (Atlas does);
# standalone mongod automatically falls back to short polling.
INTELLIGENCE_REALTIME_ENABLED=true
INTELLIGENCE_REALTIME_POLL_SECONDS=5
INTELLIGENCE_REALTIME_RECONCILE_SECONDS=300
INTELLIGENCE_KNOWLEDGE_REBUILD_ON_START=true

# Embeddings and brief generation.
# local            - deterministic hashed vectors, no account required
# cloudflare       - Cloudflare Workers AI (requires both values below)
# openai           - OpenAI, if you have a working key
INTELLIGENCE_EMBEDDING_PROVIDER=cloudflare
# cloudflare is the default; local/failed providers fall back to the
# deterministic brief. Use openai only with a working key.
INTELLIGENCE_BRIEF_PROVIDER=cloudflare

# Cloudflare Workers AI. Create a token at
# https://dash.cloudflare.com/profile/api-tokens with Workers AI Read and Edit.
# The account ID is shown in the Workers AI dashboard URL or account settings.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Optional OpenAI fallback. Not needed when Cloudflare is configured.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
