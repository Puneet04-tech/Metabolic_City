# ==============================================================================
# METABOLIC CITY AI - BACKEND CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in the values for your environment.
# All duration/interval values are in milliseconds unless otherwise specified.

# ------------------------------------------------------------------------------
# SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a strong JWT secret (at least 32 chars) with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m

# ------------------------------------------------------------------------------
# DATABASE (MONGODB ATLAS)
# ------------------------------------------------------------------------------
# MONGO_URI must include tls=true or be a mongodb+srv:// URI.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/metabolic_city?retryWrites=true&w=majority
MONGODB_DB_NAME=metabolic_city

# Connection Pool & Timeouts
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_CONNECT_TIMEOUT_MS=20000

# ------------------------------------------------------------------------------
# CORS & RATE LIMITING
# ------------------------------------------------------------------------------
# CORS_ORIGINS: Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Global Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ------------------------------------------------------------------------------
# EXTERNAL TELEMETRY ADAPTERS (OPTIONAL)
# ------------------------------------------------------------------------------
# OpenWeather API
OPENWEATHER_API_KEY=
# Format: lat,lon;lat,lon
OPENWEATHER_POINTS=23.2599,77.4126;23.2032,77.0844;23.0175,76.7221
WEATHER_POLL_INTERVAL_MS=60000

# GTFS Realtime (Transit)
GTFS_RT_URL=
TRANSIT_POLL_INTERVAL_MS=10000

# ------------------------------------------------------------------------------
# AI ACTION SYNTHESIS (PHASE 3)
# ------------------------------------------------------------------------------
# Optional: If unset, the system uses a deterministic fallback logic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# FIELD DISPATCH & ESCALATION (PHASE 4)
# ------------------------------------------------------------------------------
# Twilio settings for SMS alerts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
