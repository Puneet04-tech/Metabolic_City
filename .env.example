# Server
PORT=5000
NODE_ENV=development

# Security: generate a strong JWT secret (>= 32 chars) with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m

# Database (Atlas). The +srv scheme enforces TLS. Always include a database name.
# MONGODB_DB_NAME defaults to "metabolic_city" if omitted.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/metabolic_city?retryWrites=true&w=majority
MONGODB_DB_NAME=metabolic_city
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_CONNECT_TIMEOUT_MS=20000

# CORS: comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Optional live telemetry adapters. Leave unset until municipal credentials are available.
# Format: latitude,longitude;latitude,longitude
OPENWEATHER_API_KEY=
OPENWEATHER_POINTS=23.2599,77.4126;23.2032,77.0844;23.0175,76.7221
WEATHER_POLL_INTERVAL_MS=60000
GTFS_RT_URL=
TRANSIT_POLL_INTERVAL_MS=10000

# Optional Phase 3 action narration. Without a key, the deterministic action schema fallback is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Phase 4 field dispatch and escalation SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
