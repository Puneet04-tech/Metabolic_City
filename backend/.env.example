# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/metabolic_city?retryWrites=true&w=majority
MONGODB_DB_NAME=metabolic_city

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend URL for QR Code generation
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Optional distributed Redis features. Keep disabled for local Redis 3.x.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Risk Configuration
DEFAULT_RISK_THRESHOLD=7.0

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Weather API Configuration (Open-Meteo - FREE, No API Key Required)
WEATHER_API_PROVIDER=openmeteo
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OPENMETEO_API_KEY=not_required
# Set to false to disable synthetic fallback and only use real API data
WEATHER_SYNTHETIC_FALLBACK_ENABLED=true

# Cities Configuration
PRIMARY_CITY=bhopal
CITIES=bhopal,sehore,ashta

# City Coordinates
BHOPAL_LAT=23.2599
BHOPAL_LON=77.4126
INDORE_LAT=22.7196
INDORE_LON=75.8577
SEHORE_LAT=23.2080
SEHORE_LON=77.0816
ASHTA_LAT=23.0175
ASHTA_LON=76.7221

# Transit Data Configuration
# The system measures the roads it can actually observe. Simulated transit is
# off by default: a modelled bus delay is not a measurement, and mixing the
# two would make the scores unreadable.
#
# Real transit, when the city publishes a live feed (this needs the city's
# permission):
#   GTFS_RT_URL=https://your-city.example/gtfs-rt
# Real road traffic, from TomTom (free tier: 2500 non-tile requests a day,
# India is covered, and no agreement with the city is required):
#   TOMTOM_API_KEY=your-tomtom-key
# Set this only to demonstrate the modelled path:
#   TRANSIT_SIMULATION_ENABLED=true
TRANSIT_SIMULATION_ENABLED=false
TOMTOM_API_KEY=
# How many roads are probed for traffic in each city per cycle.
TRAFFIC_PROBES_PER_CITY=60

# Real road network (OpenStreetMap). The cell set comes from this: a cell
# exists because there is a real street in it.
# Set a contact address so the OSM API can reach you.
OSM_USER_AGENT=MetabolicCity/1.0 (urban risk operations; contact you@example.org)
# How far around the city centre the network is downloaded, in degrees.
# 0.08 is about 9 km, which covers the built-up area of these cities.
OSM_NETWORK_RADIUS_DEG=0.08
# How long a downloaded network is trusted before it is fetched again.
OSM_NETWORK_REFRESH_DAYS=30

# Action synthesis uses the deterministic municipal playbook in code.

# Pipeline Settings
PIPELINE_CYCLE_MINUTES=10
PIPELINE_ENABLED=true
# How many rings of cells around each transit stop are given their own
# interpolated weather. 0 covers only the stop cells, 1 adds their neighbours.
WEATHER_COVERAGE_RING=1

# H3 Configuration
H3_RESOLUTION=8

# Risk Weights (must sum to 1.0)
WEIGHT_MOBILITY=0.4
WEIGHT_CLIMATE=0.3
WEIGHT_VULNERABILITY=0.3
