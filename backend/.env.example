# MongoDB Configuration
# For local MongoDB: MONGO_URI=mongodb://localhost:27017/metabolic_city
# For MongoDB Atlas: MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/metabolic_city?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/metabolic_city?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# OpenWeatherMap API Configuration
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_POINTS=19.0760,72.8777;19.0441,72.8280;19.1344,72.8258
WEATHER_POLL_INTERVAL_MS=60000

# GTFS-RT Configuration
GTFS_RT_URL=https://your-gtfs-rt-feed-url
TRANSIT_POLL_INTERVAL_MS=10000

# Risk Configuration
DEFAULT_RISK_THRESHOLD=7.0

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
