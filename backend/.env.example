# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/metabolic_city?retryWrites=true&w=majority
MONGODB_DB_NAME=metabolic_city

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Risk Configuration
DEFAULT_RISK_THRESHOLD=7.0

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Weather API Configuration (Open-Meteo - FREE, No API Key Required)
WEATHER_API_PROVIDER=openmeteo
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OPENMETEO_API_KEY=not_required

# Cities Configuration
PRIMARY_CITY=bhopal
CITIES=bhopal,sehore,ashta

# City Coordinates
BHOPAL_LAT=23.2599
BHOPAL_LON=77.4126
INDORE_LAT=22.7196
INDORE_LON=75.8577
SEHORE_LAT=23.2080
SEHORE_LON=77.0816
ASHTA_LAT=23.0175
ASHTA_LON=76.7221

# Transit Data Configuration
TRANSIT_DATA_SOURCE=simulated
# Options: simulated, gtfs_static, redbus
# For GTFS static: Set TRANSIT_DATA_SOURCE=gtfs_static and GTFS_FEED_URL
# For RedBus: Set TRANSIT_DATA_SOURCE=redbus
GTFS_FEED_URL=https://busmaps.com/en/india/feedlist
REDBUS_API_BASE_URL=https://www.redbus.in/search/SearchResults

# Action synthesis uses the deterministic municipal playbook in code.

# Pipeline Settings
PIPELINE_CYCLE_MINUTES=10
PIPELINE_ENABLED=true

# H3 Configuration
H3_RESOLUTION=8

# Risk Weights (must sum to 1.0)
WEIGHT_MOBILITY=0.4
WEIGHT_CLIMATE=0.3
WEIGHT_VULNERABILITY=0.3
